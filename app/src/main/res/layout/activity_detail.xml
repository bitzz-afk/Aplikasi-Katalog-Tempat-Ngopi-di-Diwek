<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF7"
    tools:context=".DetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:paddingTop="50dp">

        <!-- NAMA CAFE -->
        <TextView
            android:id="@+id/lblNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#4E342E"
            android:layout_marginBottom="6dp"/>

        <!-- REALTIME LBS PIN LOCATION -->
        <TextView
            android:id="@+id/lblLokasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1E88E5"
            android:textStyle="italic"
            android:gravity="center"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- FRAME IMAGE UTAMA KEDAI KOPI -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/lblGambar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"
                android:contentDescription="Foto Kedai Kopi"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="*Klik gambar untuk perbesar (Fullscreen)"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- CARD DETAIL INFO LENGKAP KAFE PREMIUM -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#F5EBE6"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- BARIS EXTRA INFO: RATING, HARGA, JAM OPERASIONAL -->
                <TextView
                    android:id="@+id/txtExtraInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Rating: -  |  💰 Rentang: -  |  🕒 Buka: -"
                    android:textColor="#4E342E"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <!-- FASILITAS KEDAI -->
                <TextView
                    android:id="@+id/txtFasilitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Fasilitas: WiFi, Colokan"
                    android:textColor="#5D4037"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0D4CE"
                    android:layout_marginBottom="12dp"/>

                <!-- DAFTAR MENU -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#4E342E"
                        android:layout_marginRight="6dp"
                        android:contentDescription="Menu Icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menu Tersedia:"
                        android:textStyle="bold"
                        android:textColor="#5D4037"
                        android:textSize="15sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#3E2723"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginLeft="22dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0D4CE"
                    android:layout_marginBottom="12dp"/>

                <!-- DESKRIPSI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#4E342E"
                        android:layout_marginRight="6dp"
                        android:contentDescription="Desc Icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi:"
                        android:textStyle="bold"
                        android:textColor="#5D4037"
                        android:textSize="15sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDeskripsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#3E2723"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginLeft="22dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TOMBOL NAVIGASI PINTAR (PREV & NEXT) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="◀ Previous"
                android:backgroundTint="#8D6E63"
                android:textColor="@android:color/white"
                android:layout_marginRight="4dp"
                app:cornerRadius="12dp"/>

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Next ▶"
                android:backgroundTint="#8D6E63"
                android:textColor="@android:color/white"
                android:layout_marginLeft="4dp"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- BACK BUTTON -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Kembali ke Menu"
            android:backgroundTint="#757575"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            app:cornerRadius="25dp"/>

    </LinearLayout>
</ScrollView>