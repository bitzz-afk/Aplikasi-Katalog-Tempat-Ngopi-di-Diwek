<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp"
    android:paddingTop="50dp"
    android:background="#FDFBF7"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@id/switchMode"
            android:layout_marginRight="8dp">

            <ImageView
                android:id="@+id/imgLogoCoffee"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/logo_kopi_diwek"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Kopi Diwek" />

            <TextView
                android:id="@+id/txtTitleHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Katalog Ngopi Diwek"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#4E342E"/>
        </LinearLayout>

        <Switch
            android:id="@+id/switchMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark"
            android:textColor="#5D4037"
            android:textStyle="bold"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            tools:ignore="UseSwitchCompatOrMaterialXml" />
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="#A1887F"
                    android:layout_marginRight="6dp"
                    android:contentDescription="Icon Filter"/>
                <TextView
                    android:id="@+id/txtLabelFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter Pencarian Spesifik:"
                    android:textStyle="bold"
                    android:textColor="#5D4037"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kategori Jenis"
                        android:textSize="11sp"
                        android:textColor="#8D6E63"/>
                    <Spinner
                        android:id="@+id/spinnerFasilitas"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        style="?android:attr/spinnerStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rentang Harga"
                        android:textSize="11sp"
                        android:textColor="#8D6E63"/>
                    <Spinner
                        android:id="@+id/spinnerHarga"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        style="?android:attr/spinnerStyle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standar Rating"
                        android:textSize="11sp"
                        android:textColor="#8D6E63"/>
                    <Spinner
                        android:id="@+id/spinnerRating"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        style="?android:attr/spinnerStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jam Operasional"
                        android:textSize="11sp"
                        android:textColor="#8D6E63"/>
                    <Spinner
                        android:id="@+id/spinnerJamBuka"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        style="?android:attr/spinnerStyle" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#A1887F"
                    android:layout_marginRight="6dp"
                    android:contentDescription="Icon Location"/>
                <TextView
                    android:id="@+id/txtLabelPilih"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Kedai Kopi:"
                    android:textStyle="bold"
                    android:textColor="#5D4037"
                    android:textSize="14sp"/>
            </LinearLayout>

            <Spinner
                android:id="@+id/comboTempat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                style="?android:attr/spinnerStyle" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnPilih"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Lihat Detail Cafe"
        android:backgroundTint="#4E342E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:cornerRadius="27dp" />

</LinearLayout>